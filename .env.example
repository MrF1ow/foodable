# Postgres connection string (required). `bun run db:dev init` prints the one
# for its local cluster (port 54330). On Railway, reference the database
# service instead: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/foodable

OAUTH_CLIENT_ID=your-client-id
OAUTH_CLIENT_SECRET=your-client-secret
SESSION_SECRET=your-session-secret-at-least-32-characters

# Open Food Facts requires a User-Agent identifying your app + contact, in the
# form "AppName (email)". Used for barcode lookups (lookup_barcode tool).
OFF_USER_AGENT=Foodable (you@example.com)

PORT=8080

# Optional. Canonical public origin (scheme + host, no path), advertised in
# OAuth metadata and the MCP icon URL. When set, getBaseUrl returns it and
# ignores X-Forwarded-*. Without a proxy that strips those headers, a client
# can otherwise steer the advertised URLs. Leave unset for local development
# so the request Host / X-Forwarded-* still win.
# PUBLIC_ORIGIN=https://foodable.example.com

# Optional. Comma-separated extra OAuth redirect URIs allowed at /authorize and
# POST /register (exact match after URL normalization), in addition to the
# built-in Claude, ChatGPT, and loopback callbacks.
# ALLOWED_REDIRECT_URIS=https://my-bot.example/oauth/callback

# Which address auth rate limits and ban keys use. Railway sets
# RAILWAY_ENVIRONMENT_ID and defaults to x-real-ip (the edge overwrites it).
# Direct Docker exposure defaults to socket (the TCP peer). nginx with
# $proxy_add_x_forwarded_for needs x-forwarded-for and TRUSTED_PROXY_HOPS=1, or
# proxy_set_header X-Real-IP $remote_addr with x-real-ip. With x-forwarded-for,
# too many hops walks into client-supplied entries and lets them pick their key;
# too few keys on a proxy address (coarse but not spoofable).
# CLIENT_IP_SOURCE=socket|x-real-ip|x-forwarded-for
# TRUSTED_PROXY_HOPS=1
# Cloudflare + Railway: generate with `openssl rand -hex 32`, set here, and add a
# Cloudflare Transform Rule (Modify Request Header) that sets
# x-foodable-origin-secret to the same value on your hostname. Without it,
# rate limits key on the Cloudflare edge address (safe but coarse).
# CLOUDFLARE_ORIGIN_SECRET=

# Optional. Railway project token — enables Railway feature flags at runtime.
# Without it, every temporary flag uses its fallback (off) and every kill switch
# stays on. The SDK's RAILWAY_API_TOKEN fallback is deliberately not used.
# RAILWAY_TOKEN=

# Optional. Read only when RAILWAY_TOKEN is unset. Override flags for self-hosted
# deploys: comma-separated flag:mode entries. Modes: all (on for everyone), off
# (off for everyone), internal (on for the deploy owner: user-unit flags match
# role owner; household-unit flags match any household context). Unknown names
# and unknown modes log a warning and are ignored.
# FOODABLE_FLAGS=ui-v2:internal
